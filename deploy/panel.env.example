# Place in /etc/sing-box-panel/panel.env with mode 0600 and root ownership.
PANEL_ADMIN_PASSWORD=
PANEL_PUBLIC_URL=https://panel.example.com
PANEL_LISTEN=127.0.0.1:8080
# Set true only with a trusted proxy that overwrites X-Real-IP.
PANEL_TRUST_LOCAL_PROXY=false
PANEL_DATABASE=/var/lib/sing-box-panel/panel.db
PANEL_WEB_DIR=/opt/sing-box-panel/web
PANEL_TIME_ZONE=Asia/Shanghai
PANEL_POLL_INTERVAL=15s
PANEL_NODE_MODE=managed
PANEL_NODE_HOST=node.example.com
PANEL_NODE_PORT=8443
PANEL_NODE_LISTEN=::
PANEL_REALITY_SERVER_NAME=
PANEL_REALITY_PRIVATE_KEY=
PANEL_REALITY_SHORT_ID=
PANEL_STATS_ADDRESS=127.0.0.1:10085
PANEL_SING_BOX_BINARY=/usr/local/bin/sing-box-panel-core
PANEL_SING_BOX_CONFIG=/var/lib/sing-box-panel/node.json
PANEL_NODE_CONTROL=systemctl
